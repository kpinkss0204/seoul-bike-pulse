{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadModelArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/models/*"
      ]
    },
    {
      "Sid": "ReadModelRegistry",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:905765459883:table/bikepulse-dev-model-registry",
        "arn:aws:dynamodb:ap-northeast-2:905765459883:table/bikepulse-dev-model-registry/index/*"
      ]
    },
    {
      "Sid": "WriteAndReadPredictionEvents",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-northeast-2:905765459883:table/bikepulse-dev-prediction-events",
        "arn:aws:dynamodb:ap-northeast-2:905765459883:table/bikepulse-dev-prediction-events/index/*"
      ]
    },
    {
      "Sid": "StartAdminWorkflows",
      "Effect": "Allow",
      "Action": [
        "states:StartExecution"
      ],
      "Resource": [
        "arn:aws:states:ap-northeast-2:905765459883:stateMachine:bikepulse-dev-training-pipeline",
        "arn:aws:states:ap-northeast-2:905765459883:stateMachine:bikepulse-dev-deployment-pipeline"
      ]
    }
  ]
}
