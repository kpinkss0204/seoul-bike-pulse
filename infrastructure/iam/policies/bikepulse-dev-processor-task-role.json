{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDataBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2"
      ]
    },
    {
      "Sid": "ReadData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/raw/*",
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/curated/*",
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/features/*",
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/splits/*"
      ]
    },
    {
      "Sid": "WriteProcessedData",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/curated/*",
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/features/*",
        "arn:aws:s3:::bikepulse-905765459883-ap-northeast-2/splits/*"
      ]
    }
  ]
}
