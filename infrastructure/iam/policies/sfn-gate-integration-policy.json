{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunPipelineGateTask",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask"
      ],
      "Resource": "arn:aws:ecs:ap-northeast-2:905765459883:task-definition/bikepulse-dev-processor-task:*"
    },
    {
      "Sid": "PassReadOnlyGateRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::905765459883:role/bikepulse-dev-gate-task-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
