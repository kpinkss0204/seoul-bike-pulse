        "PlatformVersion": "LATEST",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-0ddbb9042cd53dcaf"
            ],
            "SecurityGroups": [
              "sg-0ce258c1bff6213ca"
            ],
            "AssignPublicIp": "DISABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "processor",
              "Command": [
                "--gate",
                "raw"
              ],
              "Environment": []
            }
          ]
        }
      },
      "TimeoutSeconds": 900,
      "ResultPath": "$.taskResult",
      "Retry": [
        {
          "ErrorEquals": [
            "AmazonECS.Unknown"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.taskError",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "RawQualityGateExitCheck"
    },
    "RawQualityGateExitCheck": {
      "Type": "Choice",
      "Choices": [
