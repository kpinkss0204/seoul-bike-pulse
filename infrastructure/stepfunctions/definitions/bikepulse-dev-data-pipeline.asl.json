    "CheckInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.simulate_failure",
          "BooleanEquals": true,
          "Next": "IntentionalFailure"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "validate_only",
          "Next": "RawQualityGate"
        },
        {
          "Variable": "$.mode",
          "StringEquals": "train_candidate",
          "Next": "RawQualityGate"
        }
      ],
      "Default": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "BikePulsePipelineFailed",
      "Cause": "Review the preceding state and ECS CloudWatch Logs"
    },
    "ValidationCompleted": {
      "Type": "Succeed"
    },
    "CandidateTrainingCompleted": {
      "Type": "Succeed"
    },
    "RawQualityGate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "arn:aws:ecs:ap-northeast-2:905765459883:cluster/bikepulse-dev-ecs",
